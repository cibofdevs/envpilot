# Copy this file to .env before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=envpilot
DB_USERNAME=envpilot
DB_PASSWORD=envpilot
POSTGRES_PORT=5432

# --- Vault (dev mode) ---
# Root token for the local dev Vault instance. Change this to any string.
VAULT_TOKEN=envpilot-dev-token
VAULT_PORT=8200

# --- Application secrets (seeded into Vault at envpilot/envpilot) ---
# Must be a Base64-encoded string (JwtUtils base64-decodes it to build the signing key).
# Generate your own with: openssl rand -base64 32
JWT_SECRET=BgUhdECBVBnxChZz7nxlnRDXANsPLLNMVckkqZKEpYY=
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# --- Backend ---
BACKEND_PORT=9095

# --- Frontend (baked into the React build) ---
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:9095/api
REACT_APP_WS_URL=ws://localhost:9095
