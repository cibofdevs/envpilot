# --- Build stage ---
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# CRA bakes REACT_APP_* vars into the build at build time
ARG REACT_APP_API_URL=http://localhost:9095/api
ARG REACT_APP_WS_URL=ws://localhost:9095
ARG REACT_APP_APP_NAME=EnvPilot
ARG REACT_APP_APP_VERSION=1.0.0
ARG REACT_APP_ENABLE_MFA=true
ARG REACT_APP_ENABLE_REAL_TIME_NOTIFICATIONS=true
ARG REACT_APP_ENABLE_ANALYTICS=true
ARG REACT_APP_API_TIMEOUT=60000
ARG REACT_APP_API_RETRY_COUNT=3
ARG REACT_APP_API_RETRY_DELAY=1000
ARG REACT_APP_DEBUG_MODE=false
ARG REACT_APP_LOG_LEVEL=info

ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_WS_URL=$REACT_APP_WS_URL \
    REACT_APP_APP_NAME=$REACT_APP_APP_NAME \
    REACT_APP_APP_VERSION=$REACT_APP_APP_VERSION \
    REACT_APP_ENABLE_MFA=$REACT_APP_ENABLE_MFA \
    REACT_APP_ENABLE_REAL_TIME_NOTIFICATIONS=$REACT_APP_ENABLE_REAL_TIME_NOTIFICATIONS \
    REACT_APP_ENABLE_ANALYTICS=$REACT_APP_ENABLE_ANALYTICS \
    REACT_APP_API_TIMEOUT=$REACT_APP_API_TIMEOUT \
    REACT_APP_API_RETRY_COUNT=$REACT_APP_API_RETRY_COUNT \
    REACT_APP_API_RETRY_DELAY=$REACT_APP_API_RETRY_DELAY \
    REACT_APP_DEBUG_MODE=$REACT_APP_DEBUG_MODE \
    REACT_APP_LOG_LEVEL=$REACT_APP_LOG_LEVEL

RUN npm run build

# --- Runtime stage ---
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
